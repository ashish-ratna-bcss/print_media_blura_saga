# Copy to .env and edit. .env is gitignored; this file is not, so it must
# never contain a real password.
#
#   cp .env.example .env
#   python scripts/db_check.py
#
# A real environment variable always beats a value set here, so a container or
# systemd unit can override any of this without editing the file.


# ---------------------------------------------------------------- database

# Local MongoDB. The default if EPAPER_MONGO is unset.
EPAPER_MONGO=mongodb://localhost:27017

# MongoDB Atlas. Two accepted forms -- SRV is preferred, since it discovers the
# replica set members by DNS and keeps working when Atlas moves them:
#
#   EPAPER_MONGO=mongodb+srv://USER:PASSWORD@CLUSTER.xxxxxxx.mongodb.net/?retryWrites=true&w=majority
#
# The older seed-list form, which names each shard host explicitly:
#
#   EPAPER_MONGO=mongodb://USER:PASSWORD@host-shard-00-00.xxxxxxx.mongodb.net:27017,host-shard-00-01.xxxxxxx.mongodb.net:27017,host-shard-00-02.xxxxxxx.mongodb.net:27017/?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin
#
# Notes that save an afternoon:
#   - SRV needs dnspython (in requirements.txt). The seed-list form does not.
#   - A password with @ : / ? # [ ] % must be percent-encoded. `@` -> %40.
#   - Atlas rejects connections from unlisted IPs. Network Access -> add your
#     address. The symptom is a timeout, not an auth error, which is
#     misleading; scripts/db_check.py names it for you.
#   - Whatever database Atlas puts at the end of the URI is IGNORED. The
#     database is EPAPER_MONGO_DB and nothing else. See epaper/config.py.

# The database this project owns. On a shared cluster this is the only thing
# keeping the corpus out of everyone else's data, so give it a name nobody
# else would pick.
EPAPER_MONGO_DB=epaper_corpus

# Separate database for the regression harness, so tests cannot write fixtures
# into the live corpus. They have before.
EPAPER_MONGO_TEST_DB=epaper_corpus_test

# Milliseconds before giving up on connecting. Defaults to 4000 for localhost
# and 15000 for anything else -- Atlas needs the larger figure for the TLS
# handshake and replica-set discovery. Set only if the default is wrong.
#EPAPER_MONGO_TIMEOUT_MS=15000
#EPAPER_MONGO_CONNECT_MS=15000

# Shows up in the Atlas connection list, which is how you tell this app's
# traffic apart from everything else on the cluster.
EPAPER_MONGO_APPNAME=epaper-corpus


# ---------------------------------------------------------------- pipeline

# Layout detection. Path to the DocLayout-YOLO weights.
#EPAPER_YOLO=C:/models/doclayout_yolo_docstructbench_imgsz1024.pt
# cuda:0, cpu, or unset to auto-detect.
#EPAPER_DEVICE=

# How headlines are read: ocr (Tesseract, fast), vlm (vision model, slower and
# better on decorative type), or auto (OCR, falling back to the model when the
# result looks unreliable).
#EPAPER_HEADLINE=ocr
#EPAPER_TESSERACT=C:/Program Files/Tesseract-OCR/tesseract.exe
#EPAPER_OCR_LANGS=eng+hin

# Vision model.
#EPAPER_VLM_BACKEND=ollama
#EPAPER_OLLAMA=http://localhost:11434
#EPAPER_VLM=qwen2.5vl:3b
#EPAPER_NUM_CTX=4096
