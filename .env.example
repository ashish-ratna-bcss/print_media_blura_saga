# cp .env.example .env

# database
EPAPER_MONGO=mongodb://localhost:27017
EPAPER_MONGO_DB=epaper_corpus
EPAPER_MONGO_TEST_DB=epaper_corpus_test
EPAPER_MONGO_APPNAME=epaper-corpus

# layout — DocLayout-YOLO
#EPAPER_YOLO=/path/to/doclayout_yolo_docstructbench_imgsz1024.pt
#EPAPER_DEVICE=mps          # Apple Silicon; use cuda:0 on NVIDIA, cpu as last resort

# OCR — IndicOCR only (BluraSaga POST /extract)
EPAPER_INDICOCR_URL=http://101.53.138.142:8000
EPAPER_HEADLINE=ocr
#EPAPER_OCR_TENANT=epaper
#EPAPER_OCR_TIMEOUT=90
#EPAPER_PREPROCESS=0

# article understanding — Qwen2.5-VL (vLLM)
EPAPER_VLM_BACKEND=vllm
EPAPER_VLLM=http://101.53.138.142:8001/v1
EPAPER_VLM=Qwen/Qwen2.5-VL-7B-Instruct
EPAPER_TEXT_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
#EPAPER_VLLM_API_KEY=
